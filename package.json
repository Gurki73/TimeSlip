{
  "name": "mitarbeiterkalender",
  "version": "1.5.16",
  "description": "An- und Abwesentheits Planer App",
  "author": "Gurki73 <no-reply@example.com>",
  "main": "js/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win64": "electron-builder --win --x64",
    "release": "bash ./release/release.sh"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "icon": "assets/icons/icon.ico",
    "appId": "com.MitarbeiterKalender.app",
    "productName": "MitarbeiterKalenderApp",
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "assets/png/Icon.png"
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "dependencies": {
    "ansi-styles": "^6.2.3",
    "axios": "^1.7.9",
    "xlsx": "^0.18.5"
  }
}
